{
  "name": "init_stamps_manifest_w32",
  "prompt": "Create project w32mod with dataWidth 32",
  "script": {
    "tool": "vbuilder",
    "args": {
      "action": "init",
      "project": "w32mod",
      "module": "w32_top",
      "targetDir": "/tmp/vb-fix-w32",
      "dataWidth": 32,
      "force": true,
      "gitInit": false
    },
    "text": "init ok VBMANIFEST_OK"
  },
  "expect": { "alive": true, "resultContains": ".vbuilder.json" }
}
